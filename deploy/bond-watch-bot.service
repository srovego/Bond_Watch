[Unit]
Description=Bond Watch Telegram command bot
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=bondwatch
Group=bondwatch
WorkingDirectory=/opt/bond-watch
ExecStart=/opt/bond-watch/.venv/bin/bond-watch bot
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/bond-watch/data /opt/bond-watch/config
PrivateTmp=true

[Install]
WantedBy=multi-user.target

